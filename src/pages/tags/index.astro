---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, groupBy } from '../../utils/posts';

const terms = groupBy(await getPosts(), 'tags');
---

<BaseLayout title="Tags">
  <section class="container narrow">
    <h1>Tags</h1>
    <ul class="term-cloud">
      {
        terms.map((term) => (
          <li>
            <a href={`/tags/${term.slug}/`}>{term.label}</a>
            <span class="count">({term.posts.length})</span>
          </li>
        ))
      }
    </ul>
    <p><a href="/blog/">&larr; All posts</a></p>
  </section>
</BaseLayout>
