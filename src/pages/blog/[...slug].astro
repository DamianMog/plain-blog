---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TermLinks from '../../components/TermLinks.astro';
import { formatDate, getPosts, isoDate, readingTime } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: posts[index - 1],
      older: posts[index + 1],
    },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const minutes = readingTime(post.body);

// Group h3 headings under the h2 before them. The footnote section's hidden
// heading is skipped, because it is not part of the post's own structure.
type TocItem = { slug: string; text: string; children: { slug: string; text: string }[] };
const tocItems: TocItem[] = [];
for (const h of headings) {
  if (h.slug === 'footnote-label') continue;
  if (h.depth === 2) tocItems.push({ slug: h.slug, text: h.text, children: [] });
  else if (h.depth === 3 && tocItems.length > 0) tocItems[tocItems.length - 1].children.push(h);
}
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate}
>
  <article class="container post">
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <h2 class="date">
        <time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
        {
          post.data.updatedDate && (
            <span> (updated <time datetime={isoDate(post.data.updatedDate)}>{formatDate(post.data.updatedDate)}</time>)</span>
          )
        }
      </h2>
      <p class="post-meta"><strong>Reading time:</strong> {minutes} {minutes === 1 ? 'minute' : 'minutes'}</p>
      {
        post.data.categories.length > 0 && (
          <p class="post-meta">
            <strong>Categories:</strong> <TermLinks kind="categories" terms={post.data.categories} />
          </p>
        )
      }
      {
        post.data.tags.length > 0 && (
          <p class="post-meta">
            <strong>Tags:</strong> <TermLinks kind="tags" terms={post.data.tags} />
          </p>
        )
      }
      {
        post.data.toc && tocItems.length > 0 && (
          <nav class="toc" aria-label="Table of contents">
            <strong>Contents</strong>
            <ol>
              {tocItems.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                  {h.children.length > 0 && (
                    <ol>
                      {h.children.map((c) => (
                        <li>
                          <a href={`#${c.slug}`}>{c.text}</a>
                        </li>
                      ))}
                    </ol>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )
      }
    </header>

    <div class="post-body">
      <Content />
    </div>

    <hr class="end-of-post" />

    <nav class="post-nav" aria-label="More posts">
      {
        older ? (
          <div class="prev">
            <small>&larr; Older</small>
            <a href={`/blog/${older.id}/`}>{older.data.title}</a>
          </div>
        ) : (
          <div />
        )
      }
      {
        newer && (
          <div class="next">
            <small>Newer &rarr;</small>
            <a href={`/blog/${newer.id}/`}>{newer.data.title}</a>
          </div>
        )
      }
    </nav>
  </article>
</BaseLayout>
