---
import { site } from '../../site.config';

const current = Astro.url.pathname;
// Highlight the section (for example the blog while reading a post), but only
// mark the exact page as the current page for assistive technology.
const inSection = (href: string) => current === href || current.startsWith(href);
---

<header class="container site-header">
  <nav class="topnav" aria-label="Main">
    <a class="topnav-title" href="/">{site.title}</a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Toggle menu" />
    <label for="nav-toggle" class="nav-burger">Menu</label>

    <ul class="topnav-list">
      {
        site.nav.map((item) => (
          <li>
            <a
              class:list={['topnav-link', { active: inSection(item.href) }]}
              href={item.href}
              aria-current={current === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
